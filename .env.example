# Copy to .env and adjust. Every setting has a default (see plan.md §4).
DOCBOT_DATA_DIR=./data
DOCBOT_SAMPLE_DIR=./sample_data
DOCBOT_MAX_UPLOAD_MB=20
# PDFs only (pages without text are OCR'd, so they get a lower limit)
DOCBOT_MAX_PDF_MB=1
DOCBOT_CHUNK_SIZE=800
DOCBOT_CHUNK_OVERLAP=100
# vector | keyword
DOCBOT_RETRIEVER=vector
# fastembed (local) | openai (sends the text of every indexed chunk and each question to OpenAI)
DOCBOT_EMBEDDER=fastembed
DOCBOT_EMBED_MODEL=BAAI/bge-small-en-v1.5
DOCBOT_OPENAI_EMBED_MODEL=text-embedding-3-small
DOCBOT_TOP_K=4
DOCBOT_MIN_SCORE_VECTOR=0.50
DOCBOT_MIN_SCORE_KEYWORD=1.0
DOCBOT_MIN_COVERAGE=0.55
# extractive | ollama | openai | anthropic
# openai and anthropic send the question and the retrieved passages to that provider (cloud).
DOCBOT_GENERATOR=extractive
DOCBOT_OLLAMA_URL=http://localhost:11434
DOCBOT_OLLAMA_MODEL=llama3.2:3b
DOCBOT_LLM_TIMEOUT_S=30
# Cloud generators: set the key for the one you use (OPENAI_API_KEY / ANTHROPIC_API_KEY also work).
# DOCBOT_OPENAI_API_KEY=sk-...
DOCBOT_OPENAI_MODEL=gpt-5-mini
# DOCBOT_ANTHROPIC_API_KEY=sk-ant-...
DOCBOT_ANTHROPIC_MODEL=claude-opus-5-5
DOCBOT_API_URL=http://localhost:8000
